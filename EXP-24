      "source": [
        "import random\n",
        "\n",
        "random.seed(42)\n",
        "\n",
        "def generate_event_stream(n=20):\n",
        "    stream = []\n",
        "\n",
        "    for _ in range(n):\n",
        "        stream.append({\n",
        "            \"hour\": random.choice([9, 10, 11, 14, 15, 16]),\n",
        "            \"failed_logins\": random.choice([0, 0, 0, 1])\n",
        "        })\n",
        "\n",
        "    stream.append({\n",
        "        \"hour\": 3,\n",
        "        \"failed_logins\": 0\n",
        "    })\n",
        "\n",
        "    stream.append({\n",
        "        \"hour\": 10,\n",
        "        \"failed_logins\": 9\n",
        "    })\n",
        "\n",
        "    return stream\n",
        "\n",
        "\n",
        "def monitor_stream(stream):\n",
        "    flags = []\n",
        "\n",
        "    for event in stream:\n",
        "        reasons = []\n",
        "\n",
        "        if event[\"hour\"] < 6 or event[\"hour\"] > 22:\n",
        "            reasons.append(\"Off-hours activity\")\n",
        "\n",
        "        if event[\"failed_logins\"] >= 5:\n",
        "            reasons.append(\"Excessive failed logins\")\n",
        "\n",
        "        if reasons:\n",
        "            flags.append({\n",
        "                \"event\": event,\n",
        "                \"reasons\": reasons\n",
        "            })\n",
        "\n",
        "    return flags\n",
        "\n",
        "\n",
        "event_stream = generate_event_stream()\n",
        "\n",
        "flags = monitor_stream(event_stream)\n",
        "\n",
        "print(f\"Stream length: {len(event_stream)}\")\n",
        "print(f\"Flags raised: {len(flags)}\\n\")\n",
        "\n",
        "for flag in flags:\n",
        "    print(flag)"
