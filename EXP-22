      "source": [
        "\n",
        "raw_events = [\n",
        "    {\n",
        "        \"source\": \"firewall\",\n",
        "        \"ip\": \"45.33.32.156\",\n",
        "        \"event\": \"blocked\"\n",
        "    },\n",
        "    {\n",
        "        \"source\": \"antivirus\",\n",
        "        \"host\": \"WIN10-05\",\n",
        "        \"event\": \"malware_detected\",\n",
        "        \"file\": \"invoice.exe\"\n",
        "    },\n",
        "    {\n",
        "        \"source\": \"server\",\n",
        "        \"event\": \"login_success\",\n",
        "        \"user\": \"admin\"\n",
        "    },\n",
        "]\n",
        "\n",
        "def normalize(events):\n",
        "    return [\n",
        "        {\n",
        "            \"source\": e[\"source\"],\n",
        "            \"event_type\": e[\"event\"],\n",
        "            \"severity\": (\n",
        "                \"high\"\n",
        "                if e[\"event\"] in (\"malware_detected\", \"blocked\")\n",
        "                else \"low\"\n",
        "            ),\n",
        "        }\n",
        "        for e in events\n",
        "    ]\n",
        "\n",
        "def correlation_engine(normalized_events):\n",
        "    return [\n",
        "        event\n",
        "        for event in normalized_events\n",
        "        if event[\"severity\"] == \"high\"\n",
        "    ]\n",
        "\n",
        "def generate_alerts(high_severity_events):\n",
        "    return [\n",
        "        f\"ALERT: {event['source']} reported {event['event_type']}\"\n",
        "        for event in high_severity_events\n",
        "    ]\n",
        "\n",
        "normalized = normalize(raw_events)\n",
        "correlated = correlation_engine(normalized)\n",
        "siem_alerts = generate_alerts(correlated)\n",
        "\n",
        "print(\"Normalized Events:\")\n",
        "for event in normalized:\n",
        "    print(event)\n",
        "\n",
        "print(\"\\nCorrelated High-Severity Events:\")\n",
        "for event in correlated:\n",
        "    print(event)\n",
        "\n",
        "print(\"\\nGenerated Alerts:\")\n",
        "for alert in siem_alerts:\n",
        "    print(alert)"
