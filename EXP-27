      "source": [
        "import re\n",
        "\n",
        "raw_log_lines = [\n",
        "    \"2026-07-25 09:15:01 INFO auth: user=jdoe action=login_success ip=10.0.0.5\",\n",
        "    \"2026-07-25 09:17:32 WARN auth: user=jdoe action=login_failed ip=10.0.0.5\",\n",
        "    \"2026-07-25 09:20:10 ERROR firewall: action=blocked ip=45.33.32.156\",\n",
        "]\n",
        "\n",
        "def logstash_parse(line):\n",
        "    pattern = r'(?P<date>\\S+) (?P<time>\\S+) (?P<level>\\w+) (?P<source>\\w+): (?P<fields>.*)'\n",
        "\n",
        "    match = re.match(pattern, line)\n",
        "\n",
        "    if not match:\n",
        "        return None\n",
        "\n",
        "    doc = match.groupdict()\n",
        "\n",
        "    field_str = doc.pop(\"fields\")\n",
        "\n",
        "    for kv in field_str.split():\n",
        "        if \"=\" in kv:\n",
        "            key, value = kv.split(\"=\", 1)\n",
        "            doc[key] = value\n",
        "\n",
        "    return doc\n",
        "\n",
        "\n",
        "elasticsearch_index = [\n",
        "    logstash_parse(line)\n",
        "    for line in raw_log_lines\n",
        "]\n",
        "\n",
        "def es_search(index, **query):\n",
        "    return [\n",
        "        doc\n",
        "        for doc in index\n",
        "        if all(doc.get(k) == v for k, v in query.items())\n",
        "    ]\n",
        "\n",
        "\n",
        "def kibana_aggregate(index, field):\n",
        "    aggregation = {}\n",
        "\n",
        "    for doc in index:\n",
        "        key = doc.get(field, \"unknown\")\n",
        "        aggregation[key] = aggregation.get(key, 0) + 1\n",
        "\n",
        "    return aggregation\n",
        "\n",
        "\n",
        "parsed_ok = all(doc is not None for doc in elasticsearch_index)\n",
        "\n",
        "failed_search = es_search(\n",
        "    elasticsearch_index,\n",
        "    action=\"login_failed\"\n",
        ")\n",
        "\n",
        "level_aggregation = kibana_aggregate(\n",
        "    elasticsearch_index,\n",
        "    \"level\"\n",
        ")\n",
        "\n",
        "print(\"Parsing Successful:\", parsed_ok)\n",
        "\n",
        "print(\"\\nParsed Documents:\")\n",
        "for doc in elasticsearch_index:\n",
        "    print(doc)\n",
        "\n",
        "print(\"\\nSearch: action=login_failed\")\n",
        "for doc in failed_search:\n",
        "    print(doc)\n",
        "\n",
        "print(\"\\nKibana Aggregation by Level:\")\n",
        "for level, count in level_aggregation.items():\n",
        "    print(f\"{level}: {count}\")"
      ],
