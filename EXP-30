        "def test_experiment2():\n",
        "    state_table = {}\n",
        "\n",
        "    allow_rules = {\n",
        "        (\"93.184.216.34\", 443)\n",
        "    }\n",
        "\n",
        "    outbound = {\n",
        "        \"src\": \"10.0.0.20\",\n",
        "        \"sport\": 51000,\n",
        "        \"dst\": \"93.184.216.34\",\n",
        "        \"dport\": 443\n",
        "    }\n",
        "\n",
        "    assert handle_outbound_syn(outbound, state_table, allow_rules) == \"allow\"\n",
        "\n",
        "    assert (\n",
        "        outbound[\"src\"],\n",
        "        outbound[\"sport\"],\n",
        "        outbound[\"dst\"],\n",
        "        outbound[\"dport\"]\n",
        "    ) in state_table\n",
        "\n",
        "    response = {\n",
        "        \"src\": \"93.184.216.34\",\n",
        "        \"sport\": 443,\n",
        "        \"dst\": \"10.0.0.20\",\n",
        "        \"dport\": 51000\n",
        "    }\n",
        "\n",
        "    assert handle_inbound_packet(response, state_table) == \"allow\"\n",
        "\n",
        "    unsolicited = {\n",
        "        \"src\": \"203.0.113.9\",\n",
        "        \"sport\": 4444,\n",
        "        \"dst\": \"10.0.0.20\",\n",
        "        \"dport\": 51000\n",
        "    }\n",
        "\n",
        "    assert handle_inbound_packet(unsolicited, state_table) == \"deny\"\n",
        "\n",
        "    print(\"All test cases passed.\")\n",
        "\n",
        "\n",
        "test_experiment2()"
