        "from urllib.parse import urlparse\n",
        "import ipaddress\n",
        "\n",
        "def detect_phishing_url(url):\n",
        "    score = 0\n",
        "    indicators = []\n",
        "\n",
        "    text = url.lower()\n",
        "    host = urlparse(url).hostname or \"\"\n",
        "\n",
        "    keywords = [\"login\", \"verify\", \"account\", \"password\"]\n",
        "\n",
        "    for keyword in keywords:\n",
        "        if keyword in text:\n",
        "            score += 1\n",
        "            indicators.append(\"Suspicious keyword: \" + keyword)\n",
        "\n",
        "    try:\n",
        "        ipaddress.ip_address(host)\n",
        "        score += 2\n",
        "        indicators.append(\"IP address used as domain\")\n",
        "    except ValueError:\n",
        "        pass\n",
        "\n",
        "    if len(host.split(\".\")) > 3:\n",
        "        score += 2\n",
        "        indicators.append(\"Excessive subdomains\")\n",
        "\n",
        "    if urlparse(url).scheme != \"https\":\n",
        "        score += 1\n",
        "        indicators.append(\"No HTTPS\")\n",
        "\n",
        "    return score, indicators\n",
        "\n",
        "\n",
        "url = input(\"Enter URL: \")\n",
        "\n",
        "score, indicators = detect_phishing_url(url)\n",
        "\n",
        "print(\"Risk Score:\", score)\n",
        "\n",
        "for indicator in indicators:\n",
        "    print(\"-\", indicator)\n",
        "\n",
        "if score >= 3:\n",
        "    print(\"Result: Possible Phishing URL\")\n",
        "else:\n",
        "    print(\"Result: Low Risk\")\n"
      ]
