      "source": [
        "from collections import Counter\n",
        "import re\n",
        "\n",
        "with open(\"server.log\", \"w\") as f:\n",
        "    for i in range(15):\n",
        "        f.write(f\"2026-07-08 Request from 203.0.113.99\\n\")\n",
        "\n",
        "    for i in range(3):\n",
        "        f.write(f\"2026-07-08 Request from 10.0.0.5\\n\")\n",
        "\n",
        "counter = Counter()\n",
        "\n",
        "with open(\"server.log\") as f:\n",
        "    for line in f:\n",
        "        match = re.search(r\"(\\d+\\.\\d+\\.\\d+\\.\\d+)\", line)\n",
        "        if match:\n",
        "            counter[match.group()] += 1\n",
        "\n",
        "print(\"Request Count\")\n",
        "\n",
        "for ip, count in counter.items():\n",
        "    print(ip, \":\", count)\n",
        "\n",
        "    if count >= 10:\n",
        "        print(\"ALERT: Possible DoS Attack from\", ip)"
      ]
