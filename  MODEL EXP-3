      "source": [
        "def check_policy_compliance(policy_text):\n",
        "    required = [\n",
        "        (\"Scope\", \"scope\"),\n",
        "        (\"Roles and Responsibilities\", \"responsibilities\"),\n",
        "        (\"Enforcement\", \"enforcement\"),\n",
        "        (\"Review Cycle\", \"review\"),\n",
        "        (\"Approval Authority\", \"approved by\")\n",
        "    ]\n",
        "\n",
        "    text = policy_text.lower()\n",
        "\n",
        "    return [\n",
        "        element\n",
        "        for element, keyword in required\n",
        "        if keyword not in text\n",
        "    ]\n",
        "\n",
        "\n",
        "policy = input(\"Enter policy text: \")\n",
        "\n",
        "missing = check_policy_compliance(policy)\n",
        "\n",
        "if missing:\n",
        "    print(\"Missing elements:\")\n",
        "    for item in missing:\n",
        "        print(\"-\", item)\n",
        "else:\n",
        "    print(\"All required governance elements are present.\")\n"
      ]
    }
  ]
