        "import hashlib\n",
        "\n",
        "def keystream(key, length):\n",
        "    result = b\"\"\n",
        "    counter = 0\n",
        "\n",
        "    while len(result) < length:\n",
        "        result += hashlib.sha256(\n",
        "            (key + str(counter)).encode()\n",
        "        ).digest()\n",
        "        counter += 1\n",
        "\n",
        "    return result[:length]\n",
        "\n",
        "\n",
        "def encrypt(message, key):\n",
        "    data = message.encode()\n",
        "    stream = keystream(key, len(data))\n",
        "    return bytes(a ^ b for a, b in zip(data, stream))\n",
        "\n",
        "\n",
        "def decrypt(ciphertext, key):\n",
        "    stream = keystream(key, len(ciphertext))\n",
        "    return bytes(a ^ b for a, b in zip(ciphertext, stream)).decode()\n",
        "\n",
        "\n",
        "message = input(\"Enter message: \")\n",
        "key = input(\"Enter shared key: \")\n",
        "\n",
        "encrypted = encrypt(message, key)\n",
        "\n",
        "print(\"Encrypted data:\", encrypted.hex())\n",
        "print(\"Decrypted data:\", decrypt(encrypted, key))\n"
      ]
