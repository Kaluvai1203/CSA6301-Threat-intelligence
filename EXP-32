        "def ips_process(packet, rules, whitelist=None):\n",
        "    \"\"\"\n",
        "    Like scan_packet, but decides whether to BLOCK (untrusted source)\n",
        "    or ALLOW-WITH-LOG (source is on the tuning whitelist).\n",
        "    \"\"\"\n",
        "\n",
        "    whitelist = whitelist or set()\n",
        "\n",
        "    alerts = scan_packet(packet, rules)\n",
        "\n",
        "    if not alerts:\n",
        "        return {\n",
        "            \"action\": \"allow\",\n",
        "            \"alerts\": []\n",
        "        }\n",
        "\n",
        "    if packet.get(\"src_ip\") in whitelist:\n",
        "        return {\n",
        "            \"action\": \"allow\",\n",
        "            \"alerts\": alerts,\n",
        "            \"note\": \"source whitelisted, alert suppressed from blocking\"\n",
        "        }\n",
        "\n",
        "    return {\n",
        "        \"action\": \"block\",\n",
        "        \"alerts\": alerts\n",
        "    }"
      ]
    },
