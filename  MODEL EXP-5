            "Enter report description: Long-term cyber risk to the organization\n",
            "Enter intended audience: Executive management\n",
            "Classification: Strategic\n"
          ]
        }
      ],
      "source": [
        "def classify_report(description, audience):\n",
        "    text = (description + \" \" + audience).lower()\n",
        "\n",
        "    strategic = [\"executive\", \"management\", \"board\", \"long-term\"]\n",
        "    tactical = [\"defender\", \"ttps\", \"tactics\", \"techniques\"]\n",
        "    operational = [\"soc analyst\", \"ioc\", \"ip address\", \"incident\"]\n",
        "\n",
        "    if any(x in text for x in strategic):\n",
        "        return \"Strategic\"\n",
        "\n",
        "    if any(x in text for x in tactical):\n",
        "        return \"Tactical\"\n",
        "\n",
        "    if any(x in text for x in operational):\n",
        "        return \"Operational\"\n",
        "\n",
        "    return \"Unclassified\"\n",
        "\n",
        "\n",
        "description = input(\"Enter report description: \")\n",
        "audience = input(\"Enter intended audience: \")\n",
        "\n",
        "print(\"Classification:\", classify_report(description, audience))\n"
      ]
    }
