            "Enter business scenario: The bank wants to detect fraudulent credit card transactions.\n",
            "Banking Fraud Prevention\n"
          ]
        }
      ],
      "source": [
        "def classify_threat_intelligence_area(description):\n",
        "    text = description.lower()\n",
        "\n",
        "    rules = [\n",
        "        (\"Banking Fraud Prevention\", [\n",
        "            \"bank\", \"credit card\", \"financial fraud\", \"transaction fraud\",\n",
        "            \"account takeover\", \"payment fraud\"\n",
        "        ]),\n",
        "        (\"Healthcare Data Protection\", [\n",
        "            \"hospital\", \"patient\", \"medical record\", \"healthcare\",\n",
        "            \"protected health information\", \"ehr\"\n",
        "        ]),\n",
        "        (\"E-Commerce Fraud Prevention\", [\n",
        "            \"e-commerce\", \"online shopping\", \"online store\", \"shopping cart\",\n",
        "            \"merchant\", \"online payment\"\n",
        "        ]),\n",
        "    ]\n",
        "\n",
        "    for area, keywords in rules:\n",
        "        if any(keyword in text for keyword in keywords):\n",
        "            return area\n",
        "\n",
        "    return \"General Threat Intelligence\"\n",
        "\n",
        "\n",
        "description = input(\"Enter business scenario: \")\n",
        "print(classify_threat_intelligence_area(description))\n",
        "\n"
      ]
    }
